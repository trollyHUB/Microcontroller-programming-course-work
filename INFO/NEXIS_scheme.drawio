        <!-- ═══════════════════════════════════════════════ -->

        <!-- DHT11 -->
        <mxCell id="dht11" value="&lt;b&gt;DHT11 (доп.)&lt;/b&gt;&lt;br&gt;T°/H запасной&lt;br&gt;1-Wire GPIO4&lt;br&gt;Подтяжка 10кОм&lt;br&gt;&lt;font color=&quot;#006600&quot;&gt;Питание: 3.3V&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="90" y="690" width="150" height="95" as="geometry" />
        </mxCell>

        <!-- KY-037 -->
        <mxCell id="ky037" value="&lt;b&gt;KY-037&lt;/b&gt;&lt;br&gt;Датчик шума&lt;br&gt;ADC1 GPIO39&lt;br&gt;30 – 90 дБ (расч.)&lt;br&gt;&lt;font color=&quot;#006600&quot;&gt;Питание: 3.3V&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="280" y="690" width="150" height="95" as="geometry" />
        </mxCell>

        <!-- MQ-135 -->
        <mxCell id="mq135" value="&lt;b&gt;MQ-135 (доп.)&lt;/b&gt;&lt;br&gt;CO&#8322; аналоговый&lt;br&gt;ADC1 GPIO36&lt;br&gt;Прогрев 48 ч&lt;br&gt;&lt;font color=&quot;#CC0000&quot;&gt;&lt;b&gt;Питание: 5V !&lt;/b&gt;&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="460" y="690" width="150" height="95" as="geometry" />
        </mxCell>

        <!-- PIR HC-SR501 -->
        <mxCell id="pir" value="&lt;b&gt;PIR HC-SR501&lt;/b&gt;&lt;br&gt;Датчик движения&lt;br&gt;Дальность: 3 – 7 м&lt;br&gt;Digital GPIO27&lt;br&gt;ISR: RISING edge&lt;br&gt;&lt;font color=&quot;#CC0000&quot;&gt;&lt;b&gt;Питание: 5V !&lt;/b&gt;&lt;/font&gt;"
