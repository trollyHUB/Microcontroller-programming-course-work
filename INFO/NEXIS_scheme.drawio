  <diagram name="NEXIS Схема" id="nexis-circuit-1">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ═══════════════════════════════════════════════ -->
        <!-- ЗАГОЛОВОК                                       -->
        <!-- ═══════════════════════════════════════════════ -->
        <mxCell id="title" value="NEXIS Wellness Station &amp;mdash; Функциональная схема подключения компонентов к ESP32 DevKit V1"
          style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;"
          vertex="1" parent="1">
          <mxGeometry x="140" y="20" width="1000" height="40" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- ESP32 DevKit V1 — центральный блок              -->
        <!-- ═══════════════════════════════════════════════ -->
        <mxCell id="esp32" value="&lt;b&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;ESP32 DevKit V1&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Xtensa LX6 dual-core 240 МГц&lt;br&gt;520 КБ SRAM | Wi-Fi 802.11 b/g/n&lt;br&gt;&lt;br&gt;&lt;b&gt;I2C:&lt;/b&gt; SDA=GPIO21, SCL=GPIO22&lt;br&gt;&lt;b&gt;UART2:&lt;/b&gt; RX=GPIO16, TX=GPIO17&lt;br&gt;&lt;b&gt;ADC1:&lt;/b&gt; GPIO36 (MQ-135), GPIO39 (KY-037)&lt;br&gt;&lt;b&gt;GPIO:&lt;/b&gt; 4(DHT11), 27(PIR)&lt;br&gt;&lt;b&gt;GPIO:&lt;/b&gt; 32(MODE), 33(OK)&lt;br&gt;&lt;b&gt;GPIO:&lt;/b&gt; 13(R), 12(G), 14(B), 25(Buzz)&lt;br&gt;&lt;br&gt;Питание: 5V USB"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;fontStyle=0;verticalAlign=middle;arcSize=5;"
          vertex="1" parent="1">
          <mxGeometry x="430" y="270" width="270" height="310" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- I2C ШИНА — промежуточный узел                  -->
        <!-- ═══════════════════════════════════════════════ -->
        <mxCell id="i2cbus" value="&lt;b&gt;I2C ШИНА&lt;/b&gt;&lt;br&gt;SDA = GPIO21&lt;br&gt;SCL = GPIO22&lt;br&gt;100 кбит/с"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="240" y="355" width="130" height="70" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- ЛЕВАЯ СТОРОНА — I2C устройства                 -->
        <!-- ═══════════════════════════════════════════════ -->

        <!-- BME280 -->
        <mxCell id="bme280" value="&lt;b&gt;BME280&lt;/b&gt;&lt;br&gt;Bosch Sensortec&lt;br&gt;Температура ±1°C&lt;br&gt;Влажность ±3%&lt;br&gt;Давление ±1 hPa&lt;br&gt;I2C адрес: 0x76&lt;br&gt;&lt;font color=&quot;#006600&quot;&gt;Питание: 3.3V&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="30" y="180" width="165" height="110" as="geometry" />
        </mxCell>

        <!-- BH1750 -->
        <mxCell id="bh1750" value="&lt;b&gt;BH1750&lt;/b&gt;&lt;br&gt;ROHM Semiconductor&lt;br&gt;Освещённость&lt;br&gt;1 – 65535 лк (16-бит)&lt;br&gt;I2C адрес: 0x23&lt;br&gt;&lt;font color=&quot;#006600&quot;&gt;Питание: 3.3V&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="30" y="340" width="165" height="100" as="geometry" />
        </mxCell>

        <!-- LCD 1602 -->
        <mxCell id="lcd1602" value="&lt;b&gt;LCD 1602 + PCF8574&lt;/b&gt;&lt;br&gt;16 × 2 символов&lt;br&gt;I2C адрес: 0x27&lt;br&gt;&lt;font color=&quot;#CC0000&quot;&gt;&lt;b&gt;Питание: 5V !&lt;/b&gt;&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="30" y="490" width="165" height="80" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- ПРАВАЯ СТОРОНА — UART                          -->
        <!-- ═══════════════════════════════════════════════ -->

        <!-- ZM106-VOC -->
        <mxCell id="zm106" value="&lt;b&gt;Winsen ZM106-VOC&lt;/b&gt;&lt;br&gt;CO&#8322; / VOC сенсор&lt;br&gt;Диапазон: 0 – 5000 ppm&lt;br&gt;UART 9600 бод (8N1)&lt;br&gt;RX-датч. → GPIO17 (TX ESP32)&lt;br&gt;TX-датч. → GPIO16 (RX ESP32)&lt;br&gt;&lt;font color=&quot;#CC0000&quot;&gt;&lt;b&gt;Питание: 5V !&lt;/b&gt;&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;strokeWidth=2;fontSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="780" y="310" width="190" height="130" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- ВЕРХ — Управление и индикация                  -->
        <!-- ═══════════════════════════════════════════════ -->

        <!-- Кнопка MODE -->
        <mxCell id="btnMode" value="&lt;b&gt;Кнопка MODE&lt;/b&gt;&lt;br&gt;GPIO32&lt;br&gt;INPUT_PULLUP&lt;br&gt;ISR: FALLING edge&lt;br&gt;Debounce: 200 мс"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="260" y="80" width="150" height="85" as="geometry" />
        </mxCell>

        <!-- Кнопка OK -->
        <mxCell id="btnOK" value="&lt;b&gt;Кнопка OK&lt;/b&gt;&lt;br&gt;GPIO33&lt;br&gt;INPUT_PULLUP&lt;br&gt;ISR: FALLING edge&lt;br&gt;Pomodoro START/STOP"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="430" y="80" width="150" height="85" as="geometry" />
        </mxCell>

        <!-- RGB LED -->
        <mxCell id="rgbLed" value="&lt;b&gt;RGB LED&lt;/b&gt;&lt;br&gt;R = GPIO13 [220 Ом]&lt;br&gt;G = GPIO12 [220 Ом]&lt;br&gt;B = GPIO14 [220 Ом]&lt;br&gt;&lt;font color=&quot;#006600&quot;&gt;Питание: 3.3V&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="600" y="70" width="155" height="95" as="geometry" />
        </mxCell>

        <!-- Зуммер -->
        <mxCell id="buzzer" value="&lt;b&gt;Зуммер (пассивный)&lt;/b&gt;&lt;br&gt;GPIO25 (ШИМ)&lt;br&gt;Резистор: 100 Ом&lt;br&gt;&lt;font color=&quot;#006600&quot;&gt;Питание: 3.3V&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="775" y="80" width="155" height="85" as="geometry" />
        </mxCell>

